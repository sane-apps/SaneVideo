default_platform(:mac)

platform :mac do
  desc "Verify build and run tests"
  lane :verify do
    begin
      scan(
        scheme: "SaneVideo",
        destination: "platform=macOS,arch=arm64",
        skip_testing: "SaneVideoUITests", # Skip environment-sensitive UITests by default
        result_bundle: true,
        output_directory: "fastlane/test_output",
        output_types: "junit", # Use junit for reliable parsing, xcresult kept for diagnostics
        clean: false, # Optimization: Allow incremental builds for speed (use verify_full for clean)
        fail_build: true
      )
    rescue => ex
      # Handle xcresulttool parsing errors gracefully
      # Tests may have passed but fastlane's trainer gem failed to parse results
      if ex.message.include?("xcresulttool") || ex.message.include?("item missing for id")
        UI.important("⚠️  xcresulttool parsing failed, but tests may have passed.")
        UI.important("📊 Check junit report at: fastlane/test_output/report.junit")
        UI.important("📦 Check xcresult bundle at: fastlane/test_output/SaneVideo.xcresult")
        
        # Verify tests actually passed by checking junit report
        junit_path = "fastlane/test_output/report.junit"
        if File.exist?(junit_path)
          junit_content = File.read(junit_path)
          failures = junit_content.scan(/failures="(\d+)"/).flatten.map(&:to_i).sum
          errors = junit_content.scan(/errors="(\d+)"/).flatten.map(&:to_i).sum
          
          if failures == 0 && errors == 0
            UI.success("✅ All tests passed (verified via junit report)")
            next # Continue lane execution
          else
            UI.user_error!("❌ Tests failed: #{failures} failures, #{errors} errors")
          end
        else
          UI.user_error!("❌ Cannot verify test results: junit report not found")
        end
      else
        # Re-raise if it's a different error
        raise ex
      end
    end
  end

  desc "Run full test suite including UI tests (requires graphical session)"
  lane :verify_full do
    begin
      scan(
        scheme: "SaneVideo",
        destination: "platform=macOS,arch=arm64",
        result_bundle: true,
        output_directory: "fastlane/test_output",
        output_types: "junit", # Use junit for reliable parsing
        clean: true
      )
    rescue => ex
      # Handle xcresulttool parsing errors gracefully
      if ex.message.include?("xcresulttool") || ex.message.include?("item missing for id")
        UI.important("⚠️  xcresulttool parsing failed, but tests may have passed.")
        UI.important("📊 Check junit report at: fastlane/test_output/report.junit")
        
        junit_path = "fastlane/test_output/report.junit"
        if File.exist?(junit_path)
          junit_content = File.read(junit_path)
          failures = junit_content.scan(/failures="(\d+)"/).flatten.map(&:to_i).sum
          errors = junit_content.scan(/errors="(\d+)"/).flatten.map(&:to_i).sum
          
          if failures == 0 && errors == 0
            UI.success("✅ All tests passed (verified via junit report)")
            next
          else
            UI.user_error!("❌ Tests failed: #{failures} failures, #{errors} errors")
          end
        else
          UI.user_error!("❌ Cannot verify test results: junit report not found")
        end
      else
        raise ex
      end
    end
  end

  desc "Run project health check (modularity audit)"
  lane :doctor do
    # This will be called by SaneMaster but can also be run directly
    sh("./Scripts/SaneMaster.rb doctor")
  end

  desc "Run SwiftLint audit"
  lane :lint do
    swiftlint(
      mode: :lint,
      executable: "swiftlint",
      ignore_exit_status: true
    )
  end

  desc "Generate Ruby quality report"
  lane :quality do
    sh("cd .. && bundle exec rubocop Scripts/ --format html --out fastlane/reports/rubocop.html || true")
    UI.success("Quality report generated at fastlane/reports/rubocop.html")
  end

  desc "Generate code coverage report"
  lane :coverage do
    # Ensure we have test results
    unless File.exist?("fastlane/test_output/SaneVideo.xcresult")
      UI.important("⚠️  No test results found. Running tests first...")
      verify
    end

    begin
      xcov(
        scheme: "SaneVideo",
        output_directory: "fastlane/coverage",
        minimum_coverage_percentage: 0.0, # Don't fail on low coverage, just report
        only_project_targets: true,
        exclude_targets: ["SaneVideoTests", "SaneVideoUITests"] # Don't include test targets
      )
      UI.success("✅ Code coverage report generated at fastlane/coverage/index.html")
    rescue => ex
      UI.important("⚠️  Code coverage generation failed: #{ex.message}")
      UI.important("   This is optional - continuing...")
    end
  end

  desc "Generate release notes from git commits"
  lane :changelog do
    notes = changelog_from_git_commits(
      between: [ENV["PREVIOUS_TAG"] || "v1.0.0", "HEAD"],
      pretty: "- %s (%an)"
    )
    File.write("../RELEASE_NOTES.md", "# Release Notes - #{Time.now.strftime('%Y-%m-%d')}\n\n#{notes}")
    UI.success("Release notes generated at RELEASE_NOTES.md")
  end

  desc "Automate macOS app screenshots"
  lane :screenshots do
    UI.message("📸 Launching SaneVideo for screenshots...")
    sh("open ./build/Products/Debug/SaneVideo.app") # Assumes built
    sleep(5) # Wait for launch
    
    # Use AppleScript to find the window and screencapture to grab it
    sh("screencapture -x -l $(osascript -e 'tell app \"SaneVideo\" to id of window 1') fastlane/screenshots/main_window.png")
    UI.success("Screenshot saved to fastlane/screenshots/main_window.png")
    
    sh("killall SaneVideo")
  end

  desc "Perform a full production release preparation"
  lane :release do
    verify
    quality
    coverage # Generate coverage report
    changelog
    sh("bundle exec ./Scripts/SaneMaster.rb check_binary")
    UI.success("Release preparation complete! Ready for distribution.")
  end
end
