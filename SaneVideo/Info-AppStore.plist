<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppStoreProductID</key>
	<string>com.sanevideo.app.pro.access.v2</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSCameraReactionEffectsEnabled</key>
	<false/>
	<key>NSCameraReactionEffectGesturesEnabledDefault</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>SaneVideo uses the camera to record you. Recordings stay on your Mac unless you export or share them.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 SaneVideo. All rights reserved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SaneVideo uses the microphone to record your voice. Audio is processed on your Mac.</string>
	<key>NSScreenCaptureDescription</key>
	<string>SaneVideo lets you record your screen effortlessly to create tutorials, demos, and professional content right from your Mac.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>SaneVideo records your screen only when you start screen capture. Recordings stay on your Mac unless you export or share them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SaneVideo turns your speech into captions on your Mac.</string>
</dict>
</plist>
