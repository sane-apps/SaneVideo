commands:
  verify: ./scripts/SaneMaster.rb verify
  test_mode: ./scripts/SaneMaster.rb tm
  clean: ./scripts/SaneMaster.rb clean
  lint: ./scripts/SaneMaster.rb lint
  launch: ./scripts/SaneMaster.rb launch
  logs: ./scripts/SaneMaster.rb logs

docs:
  - CLAUDE.md
  - README.md
  - DEVELOPMENT.md
  - ARCHITECTURE.md
  - SESSION_HANDOFF.md

mcps:
  - apple-docs
  - context7
  - github
  - xcode

appstore:
  enabled: true
  app_id: "6770294375"
  scheme: SaneVideoAppStore
  product_id: "com.sanevideo.app.pro.unlock"
  configuration: Release-AppStore
  platforms: [macos]
  category: public.app-category.video
  age_rating: "4+"
  privacy_policy_url: "https://sanevideo.com/privacy"
  support_url: "https://www.sanevideo.com/support"
  marketing_url: "https://sanevideo.com"
  metadata:
    macos:
      subtitle: "Private Video Workflow"
      promotional_text: "Record, edit, and export videos on your Mac with a local-first workflow and clear permission controls."
      description: >-
        SaneVideo is a native Mac video workflow app for creators who want recording, editing, and export without uploading project media by default.
        Record your screen, camera, and microphone, import local clips, edit on a timeline, generate captions, prepare demo packs, and export files from your Mac.
        Direct YouTube upload is not included in this build; export a local file and upload manually.
      keywords: "video recorder,screen recording,camera,timeline,export,captions,creator,mac"
      whats_new: "Initial SaneVideo release with local recording, editing, export, caption, and demo-pack workflows."
      marketing_url: "https://sanevideo.com"
  review_notes: >-
    SaneVideo is a freemium Mac App Store app. Basic is free and includes local recording, import, editing, and export surfaces. SaneVideo Pro Unlock is an optional one-time non-consumable StoreKit in-app purchase exposed from onboarding and Settings > About / License surfaces. The app requests Camera and Microphone only for recording. Screen & System Audio Recording is used for screen capture and cannot function without Apple's screen capture permission. Direct YouTube upload is disabled in this build; reviewers should use local export and manual upload if they want to inspect the export path. No website license flow, external checkout links, or license keys are used in the App Store build.
  review_notes_by_platform:
    macos: >-
      Fastest review path: launch SaneVideo, grant Camera/Microphone if prompted, inspect recording controls, import a local video if available, open Export, and verify local export settings. Basic is free and includes local recording, import, editing, and export surfaces. SaneVideo Pro Unlock is an optional one-time non-consumable App Store in-app purchase exposed from onboarding and Settings > License / About surfaces. No website license flow, no external checkout, and no license keys are used in the App Store build. Screen capture requires Screen & System Audio Recording permission because SaneVideo records the selected screen/window using Apple's screen capture APIs. Direct YouTube upload is unavailable in this build; export a local file and upload manually outside the app.
  iap:
    display_name: "SaneVideo Pro Unlock"
    description: "Unlock Pro video workflow features."
    review_note: "SaneVideo Pro Unlock is a one-time non-consumable StoreKit purchase. No external checkout links or license keys are used in the App Store build."
  accessibility_declarations:
    publish: true
    mac:
      supports_dark_interface: true
  screenshots:
    macos: Screenshots/appstore-*-dark-mac.png
  strip_frameworks:
    - Sparkle.framework
  contact:
    name: "Stephan Joseph"
    phone: "+17277589785"
    email: "hi@saneapps.com"

website: false
