# SaneProcess compliance manifest
name: SaneVideo
type: macos_app
scheme: SaneVideo
project: SaneVideo.xcodeproj
bundle_id: com.sanevideo.app

build:
  xcodegen: true

tests:
  verify_timeout_seconds: 600

release:
  team_id: M78L6FXD48
  signing_identity: "Developer ID Application"
  dist_host: dist.sanevideo.com
  site_host: sanevideo.com
  r2_bucket: sanebar-downloads
  use_sparkle: true
  min_system_version: "15.0"
  dmg:
    volume_icon: Resources/DMGIcon.icns
    file_icon: Resources/DMGIcon.icns
    window_size: "600 428"
    app_icon_pos: "150 190"
    drop_pos: "450 190"

commands:
  verify: ./scripts/SaneMaster.rb verify
  test_mode: ./scripts/SaneMaster.rb tm
  clean: ./scripts/SaneMaster.rb clean
  lint: ./scripts/SaneMaster.rb lint
  launch: ./scripts/SaneMaster.rb launch
  logs: ./scripts/SaneMaster.rb logs

docs:
  - CLAUDE.md
  - README.md
  - DEVELOPMENT.md
  - ARCHITECTURE.md
  - SESSION_HANDOFF.md

mcps:
  - apple-docs
  - context7
  - github
  - xcode

appstore:
  enabled: true
  app_id: ""
  configuration: Release-AppStore
  platforms: [macos]
  contact:
    name: "Stephan Joseph"
    phone: "+17277589785"
    email: "hi@saneapps.com"

website: false
