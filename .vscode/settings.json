{
  // ============================================
  // SaneVideo - Optimal Cursor Settings
  // ============================================
  // These settings are optimized for Swift/macOS development
  // Based on project requirements in DEVELOPMENT.md

  // ============================================
  // Swift Language Settings
  // ============================================
  "[swift]": {
    "editor.defaultFormatter": "vscode.swift-format",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "editor.rulers": [500], // Enforce 500-line limit from DEVELOPMENT.md
    "editor.wordWrap": "off",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "editor.trimFinalNewlines": true,
    "editor.detectIndentation": false
  },

  // ============================================
  // File Size Enforcement (500 line limit)
  // ============================================
  "files.maxMemoryForLargeFilesMB": 4096,
  "editor.largeFileOptimizations": true,

  // ============================================
  // SwiftLint Integration
  // ============================================
  "swiftlint.enable": true,
  "swiftlint.path": "/opt/homebrew/bin/swiftlint",
  "swiftlint.configPath": ".swiftlint.yml",
  "swiftlint.runOnSave": true,
  "swiftlint.autoFixOnSave": true,

  // ============================================
  // File Management
  // ============================================
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/build": true,
    "**/DerivedData": true,
    "**/.derivedData": true,
    "**/*.xcuserstate": true,
    "**/*.xcworkspace": false, // Keep workspace files
    "**/xcuserdata": true,
    "**/fastlane/reports": false, // Keep reports
    "**/fastlane/screenshots": false // Keep screenshots
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/build/**": true,
    "**/DerivedData/**": true,
    "**/.derivedData/**": true,
    "**/xcuserdata/**": true
  },
  "files.associations": {
    "*.swift": "swift",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "project.yml": "yaml",
    "lefthook.yml": "yaml"
  },

  // ============================================
  // Search & Navigation
  // ============================================
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/DerivedData": true,
    "**/.derivedData": true,
    "**/xcuserdata": true,
    "**/.git": true,
    "**/vendor": true,
    "**/Packages": false, // Include Swift packages
    "**/SaneVideo.xcodeproj": false // Include project file
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ============================================
  // Editor Behavior
  // ============================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false, // Too aggressive for Swift
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "off", // Better for Swift
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.snippetSuggestions": "top",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.inlineSuggest.enabled": true,

  // ============================================
  // AI/Copilot Settings (Cursor-specific)
  // ============================================
  "cursor.cpp.disabledLanguages": [],
  "cursor.general.enableAutoSave": true,
  "cursor.chat.enableCodeActions": true,
  "cursor.chat.enableFileCreation": true,
  "cursor.chat.maxTokens": 8000,
  "cursor.chat.model": "gpt-4",

  // ============================================
  // Git Integration
  // ============================================
  "git.enableSmartCommit": false, // Use lefthook instead
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.ignoreLimitWarning": true,
  "git.suggestSmartCommit": false,
  "git.allowForcePush": false,

  // ============================================
  // Terminal Settings
  // ============================================
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",

  // ============================================
  // Xcode Project Integration
  // ============================================
  "files.associations": {
    "*.pbxproj": "xml",
    "*.xcscheme": "xml",
    "*.plist": "xml",
    "*.entitlements": "xml"
  },

  // ============================================
  // Performance Optimizations
  // ============================================
  "editor.semanticHighlighting.enabled": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": true,

  // ============================================
  // File Size Warnings (500 line limit)
  // ============================================
  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 20000,

  // ============================================
  // Code Lens & References
  // ============================================
  "editor.codeLens": true,
  "references.preferredLocation": "view",
  "references.includeDeclaration": true,

  // ============================================
  // Minimap & UI
  // ============================================
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.minimap.showSlider": "always",
  "editor.minimap.renderCharacters": true,
  "editor.scrollBeyondLastLine": false,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",

  // ============================================
  // Breadcrumbs
  // ============================================
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",

  // ============================================
  // Explorer
  // ============================================
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.swift": "${capture}.swift",
    "*.h": "${capture}.m",
    "*.pbxproj": "project.yml"
  },

  // ============================================
  // Workbench
  // ============================================
  "workbench.editor.enablePreview": false, // Don't replace tabs
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 20,
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#ff6b6b" // Red ruler at 500 lines
  },

  // ============================================
  // Extensions Recommendations
  // ============================================
  "extensions.ignoreRecommendations": false,
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": false
}
